{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loopedbyhand",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  // Keep the *.workers.dev URL working alongside the custom domains.
  "workers_dev": true,
  "routes": [
    { "pattern": "loopedbyhand.com", "custom_domain": true },
    { "pattern": "www.loopedbyhand.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // 1) npx wrangler d1 create loopedbyhand-db   -> paste the database_id below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loopedbyhand-db",
      "database_id": "8b508723-8f7a-473c-8ef1-ec924adbc6c0",
      "migrations_dir": "migrations"
    }
  ],

  // 2) npx wrangler kv namespace create loopedbyhand-cache   -> paste the id below
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8bb301bd57704618a9dab812b28b41af"
    }
  ]

  // 3) npx wrangler secret put ADMIN_TOKEN   (never commit it)
}
