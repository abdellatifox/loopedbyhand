---
import Logo from './Logo.astro';
import { CATEGORIES } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="topbar" aria-hidden="true"></div>
  <div class="wrap bar">
    <Logo />

    <nav aria-label="Main">
      <ul class="menu">
        <li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
        <li class="has-sub">
          <details>
            <summary class={isActive('/patterns') || isActive('/category') ? 'current' : ''}>Patterns</summary>
            <ul class="sub">
              <li><a href="/patterns">All patterns</a></li>
              {CATEGORIES.map((c) => <li><a href={`/category/${c.slug}`}>{c.name}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
        <li><a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a></li>
        <li>
          <a href="/patterns#search" class="icon-link" aria-label="Search patterns">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
        </li>
        <li>
          <button type="button" class="icon-link theme-toggle" aria-label="Dark mode" aria-pressed="false">
            <svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Light / dark toggle. The saved choice is applied before paint in Base.astro.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const syncToggle = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(dark));
    if (themeMeta) themeMeta.content = dark ? '#1a1c18' : '#ffffff';
  };
  syncToggle();
  toggle?.addEventListener('click', () => {
    const dark = document.documentElement.dataset.theme !== 'dark';
    if (dark) document.documentElement.dataset.theme = 'dark';
    else delete document.documentElement.dataset.theme;
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    syncToggle();
  });

  // Close the Patterns dropdown when clicking elsewhere or pressing Escape.
  const details = document.querySelector<HTMLDetailsElement>('.has-sub details');
  document.addEventListener('click', (e) => {
    if (details?.open && !details.contains(e.target as Node)) details.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && details?.open) {
      details.open = false;
      details.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--line); position: relative; z-index: 20; }
  .topbar { height: 6px; background: linear-gradient(90deg, var(--accent) 0 34%, var(--clay) 34% 67%, var(--rust) 67%); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 76px; flex-wrap: wrap; padding-block: 8px; }
  .menu { list-style: none; display: flex; align-items: center; gap: clamp(8px, 2.5vw, 30px); margin: 0; padding: 0; }
  .menu > li > a, summary {
    font-weight: 700; font-size: 0.95rem; color: var(--ink); text-decoration: none;
    padding: 10px 2px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
  }
  .menu a[aria-current='page'], summary.current { color: var(--accent-strong); }
  .menu a:hover, summary:hover { color: var(--accent-strong); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; width: 6px; height: 6px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-2px); margin-left: 4px; }
  .has-sub { position: relative; }
  .sub {
    position: absolute; right: 0; top: calc(100% + 6px); min-width: 210px; list-style: none; margin: 0; padding: 8px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-sm); box-shadow: var(--shadow);
  }
  .sub a { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--ink-soft); font-size: 0.95rem; }
  .sub a:hover { background: var(--surface); color: var(--ink); }
  .icon-link { color: var(--ink); }
  .theme-toggle {
    display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0; cursor: pointer;
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    transition: background 0.2s, border-color 0.2s;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent-strong); }
  .theme-toggle .i-sun, .theme-toggle[aria-pressed='true'] .i-moon { display: none; }
  .theme-toggle[aria-pressed='true'] .i-sun { display: block; }
  @media (max-width: 560px) {
    .bar { justify-content: center; }
    .menu { gap: 12px; }
    .menu > li > a, summary { font-size: 0.9rem; }
    .sub { right: auto; left: 50%; transform: translateX(-50%); }
  }
</style>
