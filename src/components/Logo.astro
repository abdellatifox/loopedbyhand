---
import { SITE } from '../lib/site';
---

<a href="/" class="logo" aria-label={`${SITE.name} home`}>
  <svg width="38" height="38" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="17" fill="var(--accent-tint)" />
    <circle cx="20" cy="20" r="11" fill="none" stroke="var(--accent)" stroke-width="2.4" />
    <path d="M11 16c5 3 13 3 18 0M11 24c5-3 13-3 18 0M16 10c3 6 3 14 0 20" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
    <path d="M30 29l6 6" stroke="var(--clay)" stroke-width="2.6" stroke-linecap="round" />
  </svg>
  <span class="logo__text">Looped <em>by hand</em></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo__text { font-family: var(--font-head); font-weight: 800; font-size: 1.25rem; color: var(--ink); letter-spacing: -0.01em; }
  .logo__text em { font-weight: 400; color: var(--accent-strong); }
</style>
